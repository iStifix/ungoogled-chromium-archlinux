diff --git a/build/linux/unbundle/libvpx.gn b/build/linux/unbundle/libvpx.gn
index 0000000..1111111 100644
--- a/build/linux/unbundle/libvpx.gn
+++ b/build/linux/unbundle/libvpx.gn
@@ -29,8 +29,28 @@ shim_headers("libvpx_shim") {
 source_set("libvpx") {
   deps = [ ":libvpx_shim" ]
   public_configs = [ ":system_libvpx" ]
 }

-# Stub for VA-API dependency (rate control functions are in system libvpx)
-source_set("libvpxrc") {
+# Rate control library for VA-API hardware acceleration
+# System libvpx doesn't expose internal RTC APIs, so we compile minimal sources
+static_library("libvpxrc") {
+  sources = [
+    "source/libvpx/vp8/vp8_ratectrl_rtc.h",
+    "source/libvpx/vp8/vp8_ratectrl_rtc.cc",
+    "source/libvpx/vp9/ratectrl_rtc.h",
+    "source/libvpx/vp9/ratectrl_rtc.cc",
+  ]
+
+  include_dirs = [
+    "source/libvpx",
+    "source/config",
+  ]
+
   public_deps = [ ":libvpx" ]
   public_configs = [ ":system_libvpx" ]
+
+  configs -= [ "//build/config/compiler:chromium_code" ]
+  configs += [ "//build/config/compiler:no_chromium_code" ]
+
+  defines = [ "WEBRTC_POSIX" ]
 }
