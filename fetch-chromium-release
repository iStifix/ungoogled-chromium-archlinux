#!/bin/bash

set -e

readonly VERSION=$1
if [[ -z $VERSION ]]; then
  echo >&2 'No version given as an argument'
  exit 1
fi

mkdir -p chromium-checkout
cd chromium-checkout
cat >.gclient <<EOF
solutions = [
  {
    "name": "src",
    "url": "https://chromium.googlesource.com/chromium/src.git",
    "managed": False,
    "custom_deps": {
      # Skip test data to avoid download hangs (192MB+ files from GCS)
      "src/content/test/data/gpu/meet_effects": None,
      "src/chrome/test/data/xr/webxr_test_pages": None,
      "src/third_party/accessibility-audit/axe-core": None,
      # Skip Android/iOS specific dependencies on Linux
      "src/third_party/android_protobuf": None,
      "src/third_party/android_system_sdk": None,
      "src/third_party/androidx": None,
    },
    "custom_vars": {
      # Disable test data downloads (prevents GCS hangs)
      "checkout_clusterfuzz_data": False,
      "download_libaom_testdata": False,
      "download_libvpx_testdata": False,
      "checkout_chromium_autofill_test_dependencies": False,
      "checkout_chromium_password_manager_test_dependencies": False,
      "checkout_glic_e2e_tests": False,
    },
  },
]
EOF

# Clone depot_tools if not exists
if [[ ! -d "depot_tools" ]]; then
  git clone --depth=1 https://chromium.googlesource.com/chromium/tools/depot_tools
fi
export PATH+=":$PWD/depot_tools" DEPOT_TOOLS_UPDATE=0
# system python fails to load six.moves module
#export VPYTHON_BYPASS='manually managed python not supported by chrome operations'

# Clone chromium source if not exists
if [[ ! -d "src" ]]; then
  git clone -b $VERSION --depth=2 https://chromium.googlesource.com/chromium/src
fi

# Sync dependencies (with retry logic for network issues)
# --jobs=1: Avoid parallel downloads that can cause hangs/timeouts
# --no-history: Shallow checkout for faster sync
# --nohooks: Don't run hooks yet (done later in PKGBUILD)
echo "Starting gclient sync (this may take 30-60 minutes)..."
MAX_RETRIES=3
RETRY_COUNT=0

while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
  if gclient sync --no-history --nohooks --jobs=4 --verbose; then
    echo "✓ gclient sync completed successfully"
    break
  else
    RETRY_COUNT=$((RETRY_COUNT + 1))
    if [ $RETRY_COUNT -lt $MAX_RETRIES ]; then
      echo "⚠ gclient sync failed, retrying ($RETRY_COUNT/$MAX_RETRIES)..."
      sleep 5
    else
      echo "✗ gclient sync failed after $MAX_RETRIES attempts"
      exit 1
    fi
  fi
done
src/build/util/lastchange.py -o src/build/util/LASTCHANGE
src/build/util/lastchange.py -m GPU_LISTS_VERSION \
  --revision-id-only --header src/gpu/config/gpu_lists_version.h
src/build/util/lastchange.py -m SKIA_COMMIT_HASH \
  -s src/third_party/skia --header src/skia/ext/skia_commit_hash.h
src/build/util/lastchange.py \
  -s src/third_party/dawn --revision src/gpu/webgpu/DAWN_VERSION
src/tools/update_pgo_profiles.py --target=linux update \
  --gs-url-base=chromium-optimization-profiles/pgo_profiles

# https://gitlab.archlinux.org/archlinux/packaging/packages/electron32/-/issues/1
src/third_party/node/update_npm_deps

find src/third_party/jdk/current -type f -delete

# NOTE: We keep src/ in place instead of moving it
# PKGBUILD will create symlink chromium-$VERSION -> chromium-checkout/src
# This allows gclient sync to complete in background without issues
echo "✓ Chromium $VERSION fetched successfully (kept in chromium-checkout/src)"
